#!/usr/bin/env python3
"""Record this shell's Agy language-server coordinates for the mail relay.

Must run inside a shell that agy spawned (only those get ANTIGRAVITY_LS_ADDRESS /
ANTIGRAVITY_CSRF_TOKEN). Writes ~/.local/state/tether-mail/agy/<cid>.session, mode
0600, atomically. Never prints the token.
"""
import json, os, signal, sys, time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import tmail  # noqa: E402

signal.signal(signal.SIGALRM, lambda *_: os._exit(0))  # bounded, and never a failing status
sys.excepthook = lambda *a: os._exit(0)  # any failure is silent and exits 0
signal.alarm(4)  # hard upper bound; the caller must never be held up
if os.environ.get("TETHER_MAIL_REGISTER_TEST_HANG") == "I-UNDERSTAND-THIS-IS-A-TEST":
    time.sleep(30)  # test hook for the alarm; needs the exact value, never set in real use
cid = os.environ.get("ANTIGRAVITY_CONVERSATION_ID", "")
ls, tok = os.environ.get("ANTIGRAVITY_LS_ADDRESS", ""), os.environ.get("ANTIGRAVITY_CSRF_TOKEN", "")
if not (cid and ls and tok):
    sys.exit(0)  # not inside an agy tool shell: nothing to do, never fail the caller
dest = tmail.path(cid, ".session")
tmp = dest + ".tmp%d" % os.getpid()
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump({"conversation_id": cid, "ls_address": ls, "csrf_token": tok,
               "agy_pid": tmail.agy_ancestor(), "registered_at": int(time.time())}, f)
os.replace(tmp, dest)
print("tether-mail: registered %s" % cid)
